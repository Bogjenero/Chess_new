{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++ build active file",
			"command": "g++",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"Main.cpp",
				"Board.cpp",
				"Iscrtavanje.cpp",
				"settingsWin.cpp",
				"StockFish.cpp",
				"loadString.cpp",
				"boardWin.cpp",
				"-o",
				"${fileDirname}/bin/Chess",
				"-lsfml-graphics",
				"-lsfml-window",
				"-lsfml-system",
				"-lGL",
				"-ldl",
				"-pthread"
			],
			"options": {
				 "cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "compiler: g++"
		}
	]
}
